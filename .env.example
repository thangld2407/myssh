# ==============================================================================
# MySSH - Configuration & Feature Flags (.env)
# ==============================================================================
# Chú thích: Bạn có thể sao chép tệp này thành .env để tùy chỉnh
# Copy this file to .env and adjust variables to your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH SERVER & LƯU TRỮ (SERVER & STORAGE)
# ------------------------------------------------------------------------------
# Cổng chạy ứng dụng MySSH (Mặc định: 8080)
PORT=8080

# Thư mục chứa dữ liệu SQLite và file tạm (Mặc định: data)
DATA_DIR=data

# Đường dẫn file SQLite Database (Mặc định: data/myssh.db)
DB_PATH=data/myssh.db

# Thư mục lưu video phiên quay terminal Asciinema .cast (Mặc định: data/recordings)
RECORDINGS_DIR=data/recordings

# ------------------------------------------------------------------------------
# 2. BẢO MẬT & MÃ HÓA (ZERO-TRUST SECURITY KEYS)
# ------------------------------------------------------------------------------
# Khóa ký JWT Token - BẮT BUỘC ĐỔI KHI PUBLIC TRÊN PRODUCTION
JWT_SECRET=myssh-super-secret-jwt-key-change-me-in-production-2026

# Khóa Master mã hóa AES-256-GCM bảo vệ Key Vault (phải đủ độ dài và an toàn)
# Chú ý: Không làm mất khóa này, nếu mất sẽ không giải mã được SSH Private Key trong DB!
MASTER_KEY=myssh-master-encryption-key-32b-change-me!

# ------------------------------------------------------------------------------
# 3. BẢO VỆ CHỐNG DÒ QUÉT MẬT KHẨU (BRUTE-FORCE RATE LIMITING)
# ------------------------------------------------------------------------------
# Bật/Tắt bộ giới hạn số lần đăng nhập sai theo IP (true/false)
RATE_LIMIT_ENABLED=true

# Số lần thử mật khẩu sai tối đa trước khi bị tạm khóa (Mặc định: 5 lần)
RATE_LIMIT_MAX_ATTEMPTS=5

# Thời gian khóa (tính bằng phút) sau khi vượt quá số lần thử sai (Mặc định: 5 phút)
RATE_LIMIT_WINDOW_MINUTES=5

# ------------------------------------------------------------------------------
# 4. BẬT/TẮT TÍNH NĂNG (FEATURE FLAGS - TOGGLE FEATURES ON/OFF)
# ------------------------------------------------------------------------------
# Đặt giá trị 'true' để BẬT hoặc 'false' để TẮT tính năng tương ứng.

# Quản lý tệp SFTP trực quan (Xem, sửa file nano/code editor, upload/download kéo thả)
FEATURE_SFTP=true

# Multi-Host Broadcast Terminal (Gõ 1 lệnh chạy đồng thời trên hàng chục máy chủ)
FEATURE_MULTI_EXEC=true

# Ghi hình phiên làm việc Terminal chuẩn Asciinema v2 (.cast) để kiểm toán bảo mật
FEATURE_SESSION_AUDIT=true

# Quản lý đường hầm SSH Port Forwarding (Local & SOCKS5 Proxy)
FEATURE_TUNNELS=true

# 1-Click Import cấu hình máy chủ từ ~/.ssh/config hoặc MobaXterm
FEATURE_IMPORT_SSH_CONFIG=true

# Thư viện lệnh DevOps mẫu (Snippets Library & Lệnh nhanh trên thanh terminal)
FEATURE_SNIPPETS=true

# Tab Lộ trình phát triển & Biểu quyết tính năng cộng đồng (Roadmap)
FEATURE_PUBLIC_ROADMAP=true

# Nút và Modal Ủng Hộ & Quyên Góp Dự Án (Sponsor & Donate)
FEATURE_SPONSOR=true
