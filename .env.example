# ==============================================================================
# MySSH - Configuration & Feature Flags (.env)
# ==============================================================================
# Instructions: Copy this template to .env and adjust variables for your setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# HTTP and WebSocket listening port (Default: 8080)
PORT=8080

# Application runtime storage directory (Default: data)
DATA_DIR=data

# SQLite database file path (Default: data/myssh.db)
DB_PATH=data/myssh.db

# Directory for storing Asciinema v2 (.cast) terminal session recordings
RECORDINGS_DIR=data/recordings

# ------------------------------------------------------------------------------
# 2. ZERO-TRUST SECURITY & CRYPTOGRAPHY KEYS
# ------------------------------------------------------------------------------
# Secret key for signing and validating JWT tokens (Auto-generated in data/.secrets on first boot if unset)
JWT_SECRET=__CHANGE_ME__

# 32-byte master key for AES-256-GCM credential vault encryption (Auto-generated in data/.secrets on first boot if unset)
# IMPORTANT: Keep this safe; losing it prevents decrypting stored SSH keys!
MASTER_KEY=__CHANGE_ME__

# ------------------------------------------------------------------------------
# 3. BRUTE-FORCE RATE LIMITING
# ------------------------------------------------------------------------------
# Enable or disable sliding-window IP rate limiter (true/false)
RATE_LIMIT_ENABLED=true

# Maximum failed login attempts allowed before temporary lockout (Default: 5)
RATE_LIMIT_MAX_ATTEMPTS=5

# Lockout window duration in minutes (Default: 5)
RATE_LIMIT_WINDOW_MINUTES=5

# ------------------------------------------------------------------------------
# 4. FEATURE FLAGS (TOGGLE CAPABILITIES ON/OFF)
# ------------------------------------------------------------------------------
# Set 'true' to enable or 'false' to disable each respective module.

# Split-screen SFTP file explorer and inline code/text editor
FEATURE_SFTP=true

# Multi-host command broadcast terminal (Grid View)
FEATURE_MULTI_EXEC=true

# Terminal session audit recording via Asciinema v2 (.cast)
FEATURE_SESSION_AUDIT=true

# SSH Port Forwarding and Dynamic SOCKS5 Tunnels
FEATURE_TUNNELS=true

# 1-click import from OpenSSH ~/.ssh/config file
FEATURE_IMPORT_SSH_CONFIG=true

# DevOps dynamic command snippet library with variable substitution
FEATURE_SNIPPETS=true

# Public product roadmap tab and community voting
FEATURE_PUBLIC_ROADMAP=false

# Author sponsor and coffee appreciation modal
FEATURE_SPONSOR=true

# Kubernetes & Kubectl Platform Integration (Pod Exec, Logs, Resource Explorer, Port Forward)
FEATURE_K8S=true
